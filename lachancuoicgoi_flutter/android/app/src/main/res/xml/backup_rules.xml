<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Call history, preferences, recovery snapshots and diagnostic exports
         are privacy-sensitive and must never leave the device via backup. -->
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
