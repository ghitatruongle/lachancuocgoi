  "red_flag_combination_rules": {
    "description": "Các tổ hợp red flag làm tăng hệ số nguy hiểm trong scoring",
    "critical_combinations": [
      {
        "flags": ["authority_claim", "financial_request", "urgency"],
        "risk_multiplier": 2.0,
        "description": "Giả danh cơ quan + yêu cầu tiền + gấp",
        "typical_scenario": "AUTH_POLICE_LAWSUIT"
      },
      {
        "flags": ["otp_request", "financial_request"],
        "risk_multiplier": 2.0,
        "description": "Yêu cầu OTP + chuyển tiền",
        "typical_scenario": "BANK_CARD_FRAUD"
      },
      {
        "flags": ["remote_access", "financial_request"],
        "risk_multiplier": 2.0,
        "description": "Cài app / chia sẻ màn hình + chuyển tiền",
        "typical_scenario": "TECH_SUPPORT_HIJACK"
      },
      {
        "flags": ["information_request", "urgency", "threat"],
        "risk_multiplier": 1.8,
        "description": "Yêu cầu thông tin + gấp + đe dọa",
        "typical_scenario": "TAX_GOV_APP"
      },
      {
        "flags": ["financial_request", "secrecy", "urgency"],
        "risk_multiplier": 1.9,
        "description": "Yêu cầu tiền + bí mật + gấp",
        "typical_scenario": "SOCIAL_DEEPFAKE_LOAN"
      },
      {
        "flags": ["family_emergency", "financial_request"],
        "risk_multiplier": 1.7,
        "description": "Người thân gặp nạn + yêu cầu tiền",
        "typical_scenario": "HOSPITAL_EMERGENCY / VIRTUAL_KIDNAPPING"
      }
    ],
    "warning_combinations": [
      {
        "flags": ["authority_claim", "verification_request"],
        "risk_multiplier": 1.3,
        "description": "Giả danh + yêu cầu xác minh"
      },
      {
        "flags": ["benefit_promise", "deposit_request"],
        "risk_multiplier": 1.4,
        "description": "Hứa hẹn lợi ích + yêu cầu đặt cọc"
      }
    ]
  },
  "psychological_tactics_rules": {
    "urgency_tactics": {
      "keywords": ["ngay", "gấp", "khẩn cấp", "nhanh", "lập tức", "không chậm trễ"],
      "time_phrases": ["trong 1 giờ", "hôm nay", "bây giờ", "ngay lập tức"],
      "risk_weight": 0.3
    },
    "threat_tactics": {
      "keywords": ["bắt", "khởi tố", "phạt", "khóa", "đóng băng", "thu hồi", "tịch thu"],
      "phrases": ["hậu quả khôn lường", "tự chịu trách nhiệm", "không còn cơ hội"],
      "risk_weight": 0.4
    },
    "authority_tactics": {
      "keywords": ["công an", "viện kiểm sát", "tòa án", "cảnh sát", "bộ", "cục"],
      "phrases": ["lệnh của", "theo quy định", "luật pháp", "chúng tôi là"],
      "risk_weight": 0.35
    },
    "secrecy_tactics": {
      "keywords": ["bí mật", "không nói", "không được", "giữ kín"],
      "phrases": ["không được nói cho ai", "giữ bí mật tuyệt đối", "tuyệt đối bảo mật"],
      "risk_weight": 0.4
    },
    "greed_tactics": {
      "keywords": ["lợi nhuận", "giàu", "tiền", "miễn phí", "khuyến mãi"],
      "phrases": ["cơ hội vàng", "không rủi ro", "cam kết lợi nhuận", "bao lời"],
      "risk_weight": 0.25
    },
    "fear_tactics": {
      "keywords": ["nguy hiểm", "mất", "hại", "thiệt", "nạn"],
      "phrases": ["gặp rắc rối", "ảnh hưởng gia đình", "mất hết", "tan nát"],
      "risk_weight": 0.35
    }
  },
  "sentiment_rules": {
    "positive_indicators": ["cảm ơn", "tốt", "vui", "hài lòng", "đồng ý", "ok", "được", "dạ", "ạ", "chào", "xin chào"],
    "negative_indicators": ["không", "chưa", "từ chối", "không đồng ý", "không cần", "ko", "không muốn", "thôi", "bỏ", "hủy"],
    "aggressive_indicators": ["mày", "tao", "chết", "đồ", "ngu", "điên", "khốn", "cút", "biến", "im", "câm"],
    "fear_indicators": ["sợ", "lo", "hoang mang", "bối rối", "không biết", "làm sao", "thế nào", "giúp", "cứu"]
  },
  "topic_coherence_rules": {
    "topic_shift_threshold": 3,
    "suspicious_topic_combinations": [
      ["AUTHORITY", "FINANCE"],
      ["FAMILY", "FINANCE", "URGENCY"],
      ["HEALTH", "FINANCE", "URGENCY"],
      ["TECH", "FINANCE", "PERSONAL_INFO"],
      ["ROMANCE", "FINANCE", "URGENCY"]
    ]
  },
  "context_scoring_rules": {
    "window_size": 5,
    "min_context_keywords": 2,
    "scoring_formula": "base_score * (1 + context_bonus) * red_flag_multiplier",
    "context_bonus_rules": [
      { "condition": "keyword_density > 0.3", "bonus": 0.2, "description": "Mật độ từ khóa cao" },
      { "condition": "topic_coherence < 0.5", "bonus": 0.15, "description": "Chủ đề không liên kết" },
      { "condition": "sentiment_shift > 2", "bonus": 0.1, "description": "Thay đổi cảm xúc đột ngột" }
    ]
  }
}