{
  "version": "2.3",
  "description": "Cấu hình scoring cho L2 GDetection Engine với scenario-based alert",
  "topicConfirmationThreshold": 3,
  "scenarioSimilarityThreshold": 0.3,
  "scenario_alert_threshold": 0.2,
  "high_keyword_threshold": 0.5,
  "riskLevelThresholds": {
    "red": 0.5,
    "orange": 0.35,
    "yellow": 0.2
  },
  "weights": {
    "keyword": 0.2,
    "topic": 0.15,
    "pattern": 0.25,
    "scenario": 0.25,
    "context": 0.1,
    "sentiment": 0.05
  },
  "l2_config": {
    "enabled": true,
    "multi_layer_enabled": true,
    "min_layers_required": 2,
    "context_window_size": 5,
    "min_confidence": 0.6,
    "deepfake_detection_enabled": true,
    "audio_anomaly_threshold": 0.75
  },
  "pattern_matching": {
    "use_risk_bonus": true,
    "max_gap_words": 10,
    "min_pattern_matches": 1
  },
  "scenario_matching": {
    "use_l2_hints": true,
    "similarity_threshold": 0.25,
    "match_dialogue": true,
    "match_triggers": true,
    "match_context": true,
    "bigram_weight": 0.3,
    "unigram_weight": 0.7
  },
  "scoring_formula": {
    "base": "weighted_sum_of_all_layers",
    "modifier": "tier_based_escalation",
    "final": "min(base_score * modifier, 1.0)"
  },
  "decision_thresholds": {
    "safe": {
      "min": 0.0,
      "max": 0.2,
      "action": "allow",
      "color": "green"
    },
    "warning": {
      "min": 0.2,
      "max": 0.35,
      "action": "warn",
      "color": "yellow"
    },
    "danger": {
      "min": 0.35,
      "max": 0.5,
      "action": "alert",
      "color": "orange"
    },
    "critical": {
      "min": 0.5,
      "max": 1.0,
      "action": "block",
      "color": "red"
    }
  },
  "performance": {
    "max_processing_time_ms": 500,
    "cache_enabled": true,
    "lazy_load_scenarios": false
  },
  "debug": {
    "log_level": "info",
    "show_layer_scores": false,
    "show_red_flags": false,
    "show_context_analysis": false
  }
}